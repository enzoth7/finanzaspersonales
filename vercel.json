{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gastos.js": {
      "maxDuration": 10
    },
    "api/saldos.js": {
      "maxDuration": 10
    },
    "api/oca.js": {
      "maxDuration": 10
    },
    "api/personal.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {"source": "/enzo", "destination": "/enzo.html"},
    {"source": "/carmen", "destination": "/carmen.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "same-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ]
}
